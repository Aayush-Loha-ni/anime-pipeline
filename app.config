# Anime pipeline config — cascading INI (cf. blndev/AI-Anime-Maker app.config).
# Resolution: app.config → local.config → dev.config (later wins).
# Copy to local.config for per-machine overrides (gitignored).
# Every key has a code default — this file documents intent, not requirements.

[General]
#debug=false

[GenAI]
# Local caption model for reference auto-describe (pipeline/captioner.py).
caption_model=Salesforce/blip-image-captioning-base
# Skip heavy AI imports (captioner). Useful for CI / UI dev.
#skip=false
max_size=1024
default_strength=0.5
default_steps=50
model_folder=./models/

[Token]
# Token bucket for /api/start|continue|redo. Off by default.
enabled=false
# Cost per full render / per scene redo.
render_cost=1
redo_cost=1
# Default grant size for POST /api/tokens/grant with n=0.
new_image=3
